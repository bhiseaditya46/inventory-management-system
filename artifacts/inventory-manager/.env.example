# STOCKROOM ACCESS - Frontend Environment Configuration
# Copy this file to artifacts/inventory-manager/.env

# Clerk Publishable Key (Matches CLERK_PUBLISHABLE_KEY from root .env)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Backend API URL (Default: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Frontend Dev Port and Base Path
PORT=5173
BASE_PATH=/
