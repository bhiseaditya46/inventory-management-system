# STOCKROOM ACCESS - Root Environment Configuration
# Copy this file to .env and fill in your actual credentials.

# 1. PostgreSQL Database URL (Neon, Supabase, Railway, Aiven, or local PostgreSQL)
# Example: postgresql://postgres:password@localhost:5432/stockroom
# Example: postgresql://USER:PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# 2. Clerk Authentication Keys (From https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# 3. Initial Administrator Email
# When this user signs in, they will automatically be granted Administrator access
ADMIN_EMAIL=your-admin-email@example.com

# 4. Backend Server Port
PORT=3001

# 5. Frontend Configuration (Optional)
# FRONTEND_PORT=5173
# VITE_API_URL=http://localhost:3001
